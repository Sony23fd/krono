generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════
// ХЭРЭГЛЭГЧ
// ═══════════════════════════════════════
model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  email     String?  @unique
  password  String?
  name      String?
  address   String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart?
  orders    Order[]

  @@index([role])
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
  CARGO_ADMIN
  DATAADMIN
}

// ═══════════════════════════════════════
// АНГИЛАЛ
// ═══════════════════════════════════════
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  imageUrl  String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive, sortOrder])
}

// ═══════════════════════════════════════
// БАРАА
// ═══════════════════════════════════════
model Product {
  id            String         @id @default(cuid())
  sku           String         @unique
  name          String
  slug          String         @unique
  description   String?
  imageUrl      String?
  images        Json?
  price         Decimal
  comparePrice  Decimal?
  costPrice     Decimal?
  weight        Decimal?       @default(0)
  categoryId    String?
  stockQuantity Int            @default(0)
  reservedStock Int            @default(0)
  lowStockAlert Int            @default(5)
  status        ProductStatus  @default(ACTIVE)
  options       Json?
  isPreOrder    Boolean        @default(false)
  isFeatured    Boolean        @default(false)
  requiresAgeVerification Boolean @default(false)
  customBadge   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      Category?      @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([status])
  @@index([categoryId])
  @@index([sku])
  @@index([slug])
  @@index([name])
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  OUT_OF_STOCK
}

// Хувилбарууд (Өнгө, Хэмжээ комбинацууд)
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  name          String
  options       Json
  price         Decimal?
  stockQuantity Int      @default(0)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ═══════════════════════════════════════
// САГС (Server-side)
// ═══════════════════════════════════════
model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String     @unique
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User?      @relation(fields: [userId], references: [id])

  @@index([expiresAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// ═══════════════════════════════════════
// ЗАХИАЛГА
// ═══════════════════════════════════════
model Order {
  id                 String         @id @default(cuid())
  orderNumber        Int            @unique @default(autoincrement())
  idempotencyKey     String         @unique
  userId             String?
  customerName       String
  customerPhone      String
  accountNumber      String?
  subtotal           Decimal        @default(0)
  deliveryFee        Decimal        @default(0)
  discount           Decimal        @default(0)
  totalAmount        Decimal        @default(0)
  orderStatus        OrderStatus    @default(PENDING)
  deliveryAddress    String?
  deliveryDate       DateTime?
  wantsDelivery      Boolean        @default(false)
  stockReservedAt    DateTime?
  stockReleasedAt    DateTime?
  note               String?
  receiptType        String?        @default("individual")
  companyRegistryNumber String?
  allowSubstitution  Boolean        @default(true)
  cancellationReason String?
  creationSource     CreationSource @default(WEB)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  items              OrderItem[]
  payments           Payment[]
  user               User?          @relation(fields: [userId], references: [id])
  
  // Loyalty Info
  loyaltyCardNumber  String?
  loyaltyAction      String?        // "SPEND" or "EARN"
  loyaltyPointsUsed  Int            @default(0)
  loyaltyPointsEarned Int           @default(0)

  @@index([orderStatus])
  @@index([customerPhone])
  @@index([idempotencyKey])
  @@index([stockReservedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CreationSource {
  WEB
  ADMIN
  POS
  API
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  productName     String
  variantName     String?
  sku             String
  quantity        Int
  unitPrice       Decimal
  totalPrice      Decimal
  selectedOptions Json?
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ═══════════════════════════════════════
// ТӨЛБӨР
// ═══════════════════════════════════════
model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  amount      Decimal
  status      PaymentStatus @default(PENDING)
  externalRef String?
  paidAt      DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([externalRef])
  @@index([status])
}

enum PaymentMethod {
  QPAY
  BANK_TRANSFER
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ═══════════════════════════════════════
// СИСТЕМ
// ═══════════════════════════════════════
model ShopSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userRole  String
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model VerifiedPhone {
  phone      String   @id
  verifiedAt DateTime @default(now())
}

model VisitorLog {
  id        String   @id @default(cuid())
  ipHash    String?
  path      String
  userAgent String?
  referrer  String?
  viewTime  Int?     @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

// ═══════════════════════════════════════
// БАННЕР (Slider)
// ═══════════════════════════════════════
model Banner {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ═══════════════════════════════════════
// LOYALTY CARD
// ═══════════════════════════════════════
model LoyaltyCard {
  id            String   @id @default(cuid())
  cardNumber    String   @unique
  pointsBalance Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([cardNumber])
}
